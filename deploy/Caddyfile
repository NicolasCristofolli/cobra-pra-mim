# Caddy — /etc/caddy/Caddyfile (aplicado por deploy/harden-server.sh)
# HTTPS automático (Let's Encrypt) para todos os domínios.

(seguranca) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

cobrapramim.cloud {
	import seguranca
	header X-Frame-Options "DENY"
	reverse_proxy 127.0.0.1:3000
}

www.cobrapramim.cloud {
	redir https://cobrapramim.cloud{uri} permanent
}

api.cobrapramim.cloud {
	import seguranca
	request_body {
		max_size 5MB
	}
	reverse_proxy 127.0.0.1:4000
}

n8n.cobrapramim.cloud {
	import seguranca
	reverse_proxy 127.0.0.1:5678
}
