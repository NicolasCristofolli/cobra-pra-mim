# --- Banco de dados ---
# Senha = POSTGRES_PASSWORD do .env da raiz (docker-compose)
DATABASE_URL=postgresql://cobra:troque-me@localhost:5435/cobra

# --- Segurança (obrigatórios) ---
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-me-openssl-rand-base64-48
# Chave mestra AES-256-GCM. PRECISA decodificar para 32 bytes.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=troque-me-openssl-rand-base64-32
# Para trocar a chave sem perder os segredos salvos, use src/db/rotate-encryption-key.ts

# --- Aplicação ---
PORT=4000
# Interface de escuta. Mantenha 127.0.0.1 em produção (acesso só via Caddy).
HOST=127.0.0.1
# URL pública da API (usada para montar a URL do webhook exibida nas Configurações)
# Produção: https://api.cobrapramim.cloud
APP_URL=http://127.0.0.1:4000
# Origem do frontend, para CORS com cookies. Produção: https://cobrapramim.cloud
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Fuso usado pelo motor de cobrança para decidir "o que vence hoje"
APP_TZ=America/Sao_Paulo

# --- WhatsApp (Evolution API — provedor único) ---
# URL da Evolution API rodando no Docker local (porta padrão 8080).
# Usada como fallback quando o usuário não informa a URL base nas Configurações.
EVOLUTION_API_URL=http://localhost:8080
# API key global da instância Evolution (AUTHENTICATION_API_KEY do docker-compose)
# Obrigatória com NODE_ENV=production (sem fallback)
EVOLUTION_API_KEY=troque-me
# --- Assinatura da plataforma (conta Asaas do Cobra pra mim) ---
# Não é a chave dos usuários: é a conta que recebe as mensalidades do SaaS.
# Sem ela, /billing/checkout responde 503. Sandbox começa com $aact_hmlg_
ASAAS_PLATFORM_API_KEY=
# Token do webhook da plataforma (Asaas > Integrações > Webhooks > Token de autenticação)
# URL do webhook: https://api.cobrapramim.cloud/webhooks/platform/asaas
ASAAS_PLATFORM_WEBHOOK_TOKEN=troque-me-openssl-rand-hex-24
# Para onde o Asaas volta após o pagamento. O domínio precisa estar cadastrado
# no Asaas (Minha Conta > Informações). Vazio = sem redirecionamento automático.
PLATFORM_CHECKOUT_SUCCESS_URL=https://cobrapramim.cloud/checkout/retorno

# Agenda do motor de cobrança (padrão: todo dia às 08:00 no fuso APP_TZ)
CRON_SCHEDULE=0 8 * * *
# true desabilita o cron (útil em testes/CI)
DISABLE_CRON=false
# Produção: production (ativa cookie Secure e exige EVOLUTION_API_KEY)
NODE_ENV=development
