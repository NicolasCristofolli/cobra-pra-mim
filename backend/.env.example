# --- Banco de dados ---
DATABASE_URL=postgresql://cobra:cobra@localhost:5435/cobra

# --- Segurança (obrigatórios) ---
# Gere com: openssl rand -base64 48
JWT_SECRET=SBsv5k90fjZaeXvBne98wdzC08kRe3vrkg/02y8aEuqc2BgtkvXla8GBXUcRw0T+
# Chave mestra AES-256-GCM. PRECISA decodificar para 32 bytes.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=R2xJb5qKRbiQzlQNSFI8jbjb8Stk9I4edqH31IWARtk=

# --- Aplicação ---
PORT=4000
# URL pública da API (usada para montar a URL do webhook exibida nas Configurações)
APP_URL=http://127.0.0.1:4000
# Origem do frontend, para CORS com cookies
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Fuso usado pelo motor de cobrança para decidir "o que vence hoje"
APP_TZ=America/Sao_Paulo

# --- WhatsApp (Evolution API — provedor único) ---
# URL da Evolution API rodando no Docker local (porta padrão 8080).
# Usada como fallback quando o usuário não informa a URL base nas Configurações.
EVOLUTION_API_URL=http://localhost:8080
# API key global da instância Evolution (AUTHENTICATION_API_KEY do docker-compose)
EVOLUTION_API_KEY=cobra-evolution-local-key
# Dias de teste grátis ao criar a conta
TRIAL_DAYS=7

# Agenda do motor de cobrança (padrão: todo dia às 08:00 no fuso APP_TZ)
CRON_SCHEDULE=0 8 * * *
# true desabilita o cron (útil em testes/CI)
DISABLE_CRON=false
NODE_ENV=development
