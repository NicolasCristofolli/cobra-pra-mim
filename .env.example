# Segredos do docker-compose. Copie para .env (mesma pasta) e preencha:
#   cp .env.example .env && chmod 600 .env
# Gere valores com: openssl rand -hex 24

POSTGRES_USER=cobra
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=cobra

# Usuário próprio da Evolution, dono apenas do banco "evolution"
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=troque-me

# API key global da Evolution. A mesma vai em backend/.env (EVOLUTION_API_KEY).
# Se tiver caracteres especiais, mantenha entre aspas simples.
EVOLUTION_API_KEY=troque-me
EVOLUTION_SERVER_URL=http://localhost:8080
